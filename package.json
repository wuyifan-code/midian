{
  "name": "midian",
  "version": "0.7.11",
  "description": "Midian - a lightweight mobile-first AI chat workspace for Obsidian",
  "main": "main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mts tests/*.test.cjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "chat",
    "mobile"
  ],
  "author": "wuyifan-code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuyifan-code/midian.git"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.8.0"
  }
}
